// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "hard_tabs": false,
  "tab_size": 4,
  "format_on_save": "off",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": true,
  "show_edit_predictions": false,
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
    "enabled_in_text_threads": false,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Light"
  },
  "ssh_connections": [
    {
      "host": "100.119.10.5",
      "username": "lab",
      "projects": [
        {
          "paths": ["~/HomeServer"],
        },
      ],
    },
    {
      "host": "100.75.199.98",
      "username": "taylor",
      "projects": [
        {
          "paths": ["/home/taylor"],
        },
        {
          "paths": ["/home/taylor/fuzzer"],
        },
      ],
    },
  ],
  "base_keymap": "Zed",
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "autosave": "on_focus_change",
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_features": {
    "calt": true,
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "workspace",
          "typeCheckingMode": "strict",
        },
        "python": {
          "pythonPath": ".venv/bin/python",
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          // Ruff server settings goes here
          "lineLength": 120,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
  },
  "languages": {
    "YAML": {
      "tab_size": 2,
    },
    "Swift": {
      "enable_language_server": true,
      "language_servers": ["sourcekit-lsp"],
      "format_on_save": "off",
      "tab_size": 4
    }
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
  },
}
